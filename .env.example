# Gemini 3.5 Flash (cloud)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Ollama local model; first run: ollama pull llama3.2
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Translation provider: "auto" (try LLM first, then offline fallback) or "offline" (skip LLM, use offline only)
# Use "offline" to avoid rate limits or API costs
TRANSLATION_PROVIDER=auto

# MyMemory registered email for ~50k chars/day (anonymous is ~5k)
MYMEMORY_EMAIL=you@example.com

# Google Sign-In (OAuth web client)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
FLASK_SECRET_KEY=replace-with-a-random-secret

# Email configuration for OTP authentication
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=gaikwadgaurav250@gmail.com
SMTP_PASSWORD=rgqinfwwgdwmkjfk
FROM_EMAIL=Legelcontractanalyser@gmail.com

# Public base URL used inside emailed sign-in links.
# Local testing: http://127.0.0.1:5000 (or leave empty to use the request host).
# Production/tunnel: https://your-domain.com (no trailing slash)
APP_BASE_URL=http://127.0.0.1:5000
